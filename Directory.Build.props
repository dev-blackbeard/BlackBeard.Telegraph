<Project>

  <!-- Repository-wide build settings. Telegraph is a generic transport: nothing here, or
       anywhere else in this repository, may know what the messages it carries mean. -->

  <PropertyGroup>
    <TelegraphRepoRoot>$(MSBuildThisFileDirectory)</TelegraphRepoRoot>
    <TelegraphLocalFeed>$(TelegraphRepoRoot)artifacts/local-feed</TelegraphLocalFeed>
    <ArtifactsPath>$(TelegraphRepoRoot)artifacts</ArtifactsPath>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!--
    BOOTSTRAP ONLY, same reasoning as the Argus repositories: RS0016/RS0017/RS0037 fire while
    PublicAPI.Unshipped.txt is still empty, which it is until one real build has run with the
    analyzer's code fix applied to populate it.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);RS0016;RS0017;RS0037</NoWarn>
  </PropertyGroup>

  <!--
    This repository was authored with no .NET SDK available to compile against (see the Argus
    repositories' own history for the same constraint), so these are answered ahead of a real
    build rather than discovered by one:

      CA2000  "dispose objects before losing scope" - TelegraphSubscriber.ConnectAsync assigns a
                                                        TcpClient to a field only after an awaited
                                                        call that could throw; the analyzer cannot
                                                        prove the field assignment always happens
                                                        and flags the local regardless.
      CA1054  "URI parameters should not be strings" - TelegraphSubscriber's "host" parameter is a
                                                        hostname or IP literal, not a URI.
      CA1031  "do not catch general exception types" - every catch in this repository already
                                                        names a specific exception type; kept off
                                                        in case a future analyzer version widens
                                                        what it considers "general".
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA2000;CA1054;CA1031</NoWarn>
  </PropertyGroup>

  <!-- Rule 10-equivalent: deterministic builds, SourceLink, symbol packages. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(TF_BUILD)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Package metadata shared by every packable project. -->
  <PropertyGroup>
    <TelegraphPackageVersion Condition="'$(TelegraphPackageVersion)' == ''">0.1.0-local</TelegraphPackageVersion>
    <Version>$(TelegraphPackageVersion)</Version>
    <Authors>Telegraph contributors</Authors>
    <Product>Telegraph</Product>
    <Company></Company>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>transport;tcp;jsonl;streaming;pubsub</PackageTags>
    <Copyright>Copyright the Telegraph contributors</Copyright>
    <RepositoryType>git</RepositoryType>
    <PackageOutputPath>$(TelegraphLocalFeed)</PackageOutputPath>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <IsTestProject Condition="'$(IsTestProject)' == '' and $(MSBuildProjectName.EndsWith('.Tests'))">true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1707;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(TelegraphRepoRoot)README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(TelegraphRepoRoot)icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
