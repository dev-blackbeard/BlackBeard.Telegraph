#!/usr/bin/env bash
# pack-local -- pack Telegraph into ./artifacts/local-feed, for consuming it before it is
# published (mirrors the equivalent script in the Argus repositories).
#
# Usage: scripts/pack-local [--version <version>] [--configuration <Debug|Release>] [--clean]

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

version="${TELEGRAPH_PACKAGE_VERSION:-0.1.0-local}"
configuration="Release"
clean=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --version)
      version="${2:?--version requires a value}"
      shift 2
      ;;
    --configuration|-c)
      configuration="${2:?--configuration requires a value}"
      shift 2
      ;;
    --clean)
      clean=1
      shift
      ;;
    -h|--help)
      sed -n '2,7p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      echo "pack-local: unknown option '$1'" >&2
      exit 2
      ;;
  esac
done

feed="$repo_root/artifacts/local-feed"
mkdir -p "$feed"

if [[ $clean -eq 1 ]]; then
  find "$feed" -maxdepth 1 -type f \( -name '*.nupkg' -o -name '*.snupkg' \) -delete
fi

echo "pack-local: packing version $version ($configuration) into $feed"

dotnet pack "src/Telegraph/Telegraph.csproj" \
  --configuration "$configuration" \
  -p:TelegraphPackageVersion="$version" \
  -p:PackageOutputPath="$feed" \
  --nologo

echo ""
echo "pack-local: feed contents"
ls -1 "$feed" | sed 's/^/  /'
